  "tips": [
    {
      "id": "a1-u03-d01-t01",
      "before": "a1-u03-d01-e01",
      "title": { "en": "Counting to five" },
      "body": { "en": "*Jeden*, *dwa*, *trzy*, *cztery*, *pięć*, and before them *zero*. After *t*, *rz* is said like *sz*, so *trzy* starts with *t* and then sh, not with English ch; *cztery* starts with *cz* and *pięć* ends in *ć*. *Jeden* and *dwa* change a little with the thing they count, which a later Unit teaches. For counting and for ages they are as here." }
    },
    {
      "id": "a1-u03-d01-t02",
      "before": "a1-u03-d01-e12",
      "title": { "en": "Plus" },
      "body": { "en": "Sums are said with *plus* and *to*: *dwa plus dwa to cztery*. Here *to* means \"is\" or \"makes\". You will also hear *jest* in its place." }
    }
  ],
