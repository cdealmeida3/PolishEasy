  "tips": [
    {
      "id": "a1-u02-d03-t01",
      "before": "a1-u02-d03-e01",
      "title": { "en": "The plural of być" },
      "body": { "en": "*My jesteśmy*, *wy jesteście*, *oni są*. *Wy* is \"you\" said to several people. Notice *-my* for \"we\", as in *dziękujemy*, and *-cie* for \"you\" in the plural: these two endings come back in every verb." },
      "conjugation": {
        "verb": "być",
        "meaning": { "en": "to be" },
        "forms": { "ja": "jestem", "ty": "jesteś", "on": "jest", "my": "jesteśmy", "wy": "jesteście", "oni": "są" }
      }
    },
    {
      "id": "a1-u02-d03-t02",
      "before": "a1-u02-d03-e10",
      "title": { "en": "Oni and one" },
      "body": { "en": "*Oni* is \"they\" for men, or for a group with at least one man in it. *One* is \"they\" for women only, and also for children and things. Both take *są*. *I* means \"and\": *Adam i Ewa*." }
    }
  ],
