      "title": { "en": "Mieć: to have" },
      "body": { "en": "Mam, masz, ma follow a common pattern: -m for \"I\", -sz for \"you\", and no ending for \"he\" and \"she\". Mam pytanie is \"I have a question\", and masz czas? is \"do you have time?\"." },
      "conjugation": {
        "verb": "mieć",
        "meaning": { "en": "to have" },
        "forms": { "ja": "mam", "ty": "masz", "on": "ma", "my": "mamy", "wy": "macie", "oni": "mają" }
      }
    },
    {
