    {
      "id": "a1-u02-d06-t01",
      "before": "a1-u02-d06-e01",
      "title": { "en": "The plural of mieć" },
      "body": { "en": "*Mamy*, *macie*, *mają*. The endings *-my* and *-cie* are the same as in *jesteśmy* and *jesteście*, and \"they\" ends in *-ą*. *Mamy problem* is \"we have a problem\"." },
      "conjugation": {
        "verb": "mieć",
        "meaning": { "en": "to have" },
        "forms": { "ja": "mam", "ty": "masz", "on": "ma", "my": "mamy", "wy": "macie", "oni": "mają" }
      }
    },
    {
      "id": "a1-u02-d06-t02",
      "before": "a1-u02-d06-e11",
      "title": { "en": "Nazywam się" },
      "body": { "en": "*Nazywam się* is \"I am called\". It is the usual way to give a full name, and the one for formal situations: *nazywam się Adam Nowak*. *Mam na imię* gives only the first name. To ask a friend: *jak się nazywasz?*" }
    }
  ],
