  "tips": [
    {
      "id": "kpk1-l02-e-t01",
      "before": "kpk1-l02-e-e01",
      "title": {
        "en": "Eleven to nineteen"
      },
      "body": {
        "en": "From 11 to 19 the numbers end in *-naście*: *jedenaście*, *dwanaście*, *trzynaście*. Watch the spelling of three of them: *czternaście* has no *y*, and *piętnaście* and *dziewiętnaście* lose the *ć* of *pięć* and *dziewięć*."
      }
    },
    {
      "id": "kpk1-l02-e-t02",
      "before": "kpk1-l02-e-e11",
      "title": {
        "en": "Twenty and on"
      },
      "body": {
        "en": "*Dwadzieścia* is 20, and 21 to 29 put a number after it: *dwadzieścia jeden*, *dwadzieścia dwa*, up to *dwadzieścia dziewięć*. A phone number is often said in pairs of digits: *dwanaście, dwadzieścia trzy, trzynaście*."
      }
    }
  ],
