      "title": {
        "en": "Going out"
      },
      "body": {
        "en": "*Musieć* goes *muszę, musisz, musi … muszą*. To say where you are going, use *iść* with *na* or *do*: *iść na zakupy*, *na kawę*, *na koncert*; *iść do kina*, *do lekarza*. *Ewa chce iść na kawę* is \"Ewa wants to go for a coffee\", and *Adam musi uczyć się do egzaminu* is \"Adam has to study for an exam\"."
      },
      "conjugation": {
        "verb": "musieć",
        "meaning": {
          "en": "must, to have to"
        },
        "forms": {
          "ja": "muszę",
          "ty": "musisz",
          "on": "musi",
          "my": "musimy",
          "wy": "musicie",
          "oni": "muszą"
        }
      }
    }
