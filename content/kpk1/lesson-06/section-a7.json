  "tips": [
    {
      "id": "kpk1-l06-a7-t01",
      "before": "kpk1-l06-a7-e01",
      "title": {
        "en": "Verbs in -ę, -esz"
      },
      "body": {
        "en": "Verbs like *pisać* end in *-ę* for *ja* and *-esz* for *ty*, and in *pisać* the *s* becomes *sz* in every form: *piszę, piszesz, pisze*. Only *oni* ends in *-ą*: *piszą*."
      },
      "conjugation": {
        "verb": "pisać",
        "meaning": {
          "en": "to write"
        },
        "forms": {
          "ja": "piszę",
          "ty": "piszesz",
          "on": "pisze",
          "my": "piszemy",
          "wy": "piszecie",
          "oni": "piszą"
        }
      }
    },
    {
      "id": "kpk1-l06-a7-t02",
      "before": "kpk1-l06-a7-e09",
      "title": {
        "en": "Verbs in -ować"
      },
      "body": {
        "en": "Almost every verb in *-ować* goes like *gotować*: *-ować* becomes *-uj-*, then come the endings of *-ę, -esz*: *gotuję, gotujesz … gotują*. *Pracować*, *studiować* and *interesować się* do the same."
      },
      "conjugation": {
        "verb": "gotować",
        "meaning": {
          "en": "to cook"
        },
        "forms": {
          "ja": "gotuję",
          "ty": "gotujesz",
          "on": "gotuje",
          "my": "gotujemy",
          "wy": "gotujecie",
          "oni": "gotują"
        }
      }
    }
  ],
