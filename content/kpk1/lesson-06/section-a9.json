  "tips": [
    {
      "id": "kpk1-l06-a9-t01",
      "before": "kpk1-l06-a9-e01",
      "title": {
        "en": "Verbs in -ę, -isz / -ysz"
      },
      "body": {
        "en": "Verbs like *robić* end in *-ę* for *ja* and *-isz* for *ty*: *robię, robisz, robi*. After *cz*, *sz*, *rz* and *ż* the *i* is written *y*: *tańczę, tańczysz, tańczy*. *Mówić*, *myśleć* and *uczyć się* go the same way."
      },
      "conjugation": {
        "verb": "tańczyć",
        "meaning": {
          "en": "to dance"
        },
        "forms": {
          "ja": "tańczę",
          "ty": "tańczysz",
          "on": "tańczy",
          "my": "tańczymy",
          "wy": "tańczycie",
          "oni": "tańczą"
        }
      }
    },
    {
      "id": "kpk1-l06-a9-t02",
      "before": "kpk1-l06-a9-e11",
      "title": {
        "en": "Nudzić się"
      },
      "body": {
        "en": "*Nudzić się* goes like *robić*, with *się*: *nudzę się, nudzisz się … nudzą się*. In a question the verb usually comes first: *nudzisz się?*"
      },
      "conjugation": {
        "verb": "nudzić się",
        "meaning": {
          "en": "to be bored"
        },
        "forms": {
          "ja": "nudzę się",
          "ty": "nudzisz się",
          "on": "nudzi się",
          "my": "nudzimy się",
          "wy": "nudzicie się",
          "oni": "nudzą się"
        }
      }
    }
  ],
