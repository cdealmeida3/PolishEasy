  "tips": [
    {
      "id": "kpk1-l06-a6-t01",
      "before": "kpk1-l06-a6-e01",
      "title": {
        "en": "Verbs in -m, -sz"
      },
      "body": {
        "en": "Verbs like *znać* and *umieć* end in *-m* for *ja* and *-sz* for *ty*: *znam, znasz*; *umiem, umiesz*. *Mieć*, *czytać*, *grać* and *oglądać* go the same way. *Znać* is for knowing a person, a place or a film: *znam Kraków*."
      },
      "conjugation": {
        "verb": "znać",
        "meaning": {
          "en": "to know (a person, a place)"
        },
        "forms": {
          "ja": "znam",
          "ty": "znasz",
          "on": "zna",
          "my": "znamy",
          "wy": "znacie",
          "oni": "znają"
        }
      }
    },
    {
      "id": "kpk1-l06-a6-t02",
      "before": "kpk1-l06-a6-e07",
      "title": {
        "en": "Umieć: I know how to"
      },
      "body": {
        "en": "*Umieć* is a skill, and it is followed by a verb's dictionary form: *umiem tańczyć*, *on umie grać na gitarze*. Only *oni* ends differently: *umieją*."
      },
      "conjugation": {
        "verb": "umieć",
        "meaning": {
          "en": "to know how to, can"
        },
        "forms": {
          "ja": "umiem",
          "ty": "umiesz",
          "on": "umie",
          "my": "umiemy",
          "wy": "umiecie",
          "oni": "umieją"
        }
      }
    }
  ],
