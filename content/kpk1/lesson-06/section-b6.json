      "title": {
        "en": "Want, can, must"
      },
      "body": {
        "en": "*Chcieć* (want), *móc* (can, be free to), *musieć* (must) and *umieć* (know how to) are followed by a verb's dictionary form: *chcę grać*, *nie mogę grać*, *muszę iść*. *Umiem* is a skill: *umiem grać w tenisa*. *Mogę* is being free or allowed to: *dzisiaj nie mogę*."
      },
      "conjugation": {
        "verb": "chcieć",
        "meaning": {
          "en": "to want"
        },
        "forms": {
          "ja": "chcę",
          "ty": "chcesz",
