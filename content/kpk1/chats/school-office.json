        {
          "text": "Jestem tutaj.",
          "meaning": {
            "en": "I'm here."
          },
          "note": {
            "en": "*Skąd?* asks where from. Say *z Anglii*."
          }
        },
        {
          "text": "Tak, jestem z Polski.",
          "meaning": {
            "en": "Yes, I'm from Poland."
          },
          "note": {
            "en": "You are from England, and *skąd?* is not a yes-or-no question."
          }
        }
      ]
    },
    {
