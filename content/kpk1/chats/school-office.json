  "turns": [
    {
      "id": "t1",
      "says": "Dzień dobry! Słucham.",
      "meaning": {
        "en": "Good morning! How can I help?"
      },
      "replies": [
        {
          "text": "Dzień dobry!",
          "meaning": {
            "en": "Good morning!"
          },
          "right": true,
          "next": "t2"
        },
        {
          "text": "Cześć!",
          "meaning": {
            "en": "Hi!"
          },
          "register": "informal",
          "note": {
            "en": "*Cześć* is for friends and family. To the secretary say *dzień dobry*."
          }
        },
        {
          "text": "Dobranoc!",
          "meaning": {
            "en": "Good night!"
          },
          "note": {
            "en": "*Dobranoc* is for bedtime. During the day it is *dzień dobry*."
          }
        }
      ]
    },
    {
      "id": "t2",
      "says": "Jak pan ma na imię?",
      "meaning": {
        "en": "What is your first name? (to a man)"
      },
      "replies": [
        {
          "text": "Mam na imię Adam.",
          "meaning": {
            "en": "My first name is Adam."
          },
          "right": true,
          "next": "t3",
          "acceptedAnswers": [
            "Mam na imię Adam.",
            "Adam.",
            "Nazywam się Adam.",
            "Jestem Adam."
          ]
        },
        {
          "text": "A ty?",
          "meaning": {
            "en": "And you?"
          },
          "register": "informal",
          "note": {
            "en": "*A ty?* asks a friend the same question back. Here, give your name: *mam na imię Adam*."
          }
        },
        {
          "text": "Mam dwadzieścia lat.",
          "meaning": {
            "en": "I'm twenty years old."
          },
          "note": {
            "en": "That is your age. She asked your first name, *na imię*."
          }
        }
      ]
    },
    {
      "id": "t3",
      "says": "Skąd pan jest?",
      "meaning": {
        "en": "Where are you from? (to a man)"
      },
      "replies": [
        {
          "text": "Jestem z Anglii.",
          "meaning": {
            "en": "I'm from England."
