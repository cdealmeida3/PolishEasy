  "tips": [
    {
      "id": "kpk1-l04-b1-t01",
      "before": "kpk1-l04-b1-e01",
      "title": {
        "en": "Chodzić: -ę, -isz"
      },
      "body": {
        "en": "Many verbs in *-ić* go like *mówić*: *-ę* for *ja*, *-isz* for *ty*, *-i* for *on* and *ona*, then *-imy*, *-icie* and *-ą*. In *chodzić* the *dzi* becomes *dz* before *-ę* and *-ą*: *chodzę*, *chodzą*. *Chodzić* is to go on foot, or to go somewhere regularly: *chodzę do szkoły*."
      },
      "conjugation": {
        "verb": "chodzić",
        "meaning": {
          "en": "to go (on foot, or regularly)"
        },
        "forms": {
          "ja": "chodzę",
          "ty": "chodzisz",
          "on": "chodzi",
          "my": "chodzimy",
          "wy": "chodzicie",
          "oni": "chodzą"
        }
      }
    },
    {
      "id": "kpk1-l04-b1-t02",
      "before": "kpk1-l04-b1-e11",
      "title": {
        "en": "Myśleć: to think"
      },
      "body": {
        "en": "*Myśleć* ends in *-eć*, but it goes the same way: *myślę*, *myślisz*, *myśli*, *myślimy*, *myślicie*, *myślą*. *Myślisz, że…?* asks a friend \"do you think that…?\"."
      },
      "conjugation": {
        "verb": "myśleć",
        "meaning": {
          "en": "to think"
        },
        "forms": {
          "ja": "myślę",
          "ty": "myślisz",
          "on": "myśli",
          "my": "myślimy",
          "wy": "myślicie",
          "oni": "myślą"
        }
      }
    }
  ],
