  "tips": [
    {
      "id": "kpk1-l04-b2-t01",
      "before": "kpk1-l04-b2-e01",
      "title": {
        "en": "Uczyć się: -ę, -ysz"
      },
      "body": {
        "en": "After *cz*, *sz*, *rz* and *ż* the endings are *-ę*, *-ysz* and *-y*, with *y* for *i*: *uczę się*, *uczysz się*, *uczy się*, *uczymy się*, *uczycie się*, *uczą się*. *Się* stays the same for every person."
      },
      "conjugation": {
        "verb": "uczyć się",
        "meaning": {
          "en": "to learn, to study"
        },
        "forms": {
          "ja": "uczę się",
          "ty": "uczysz się",
          "on": "uczy się",
          "my": "uczymy się",
          "wy": "uczycie się",
          "oni": "uczą się"
        }
      }
    },
    {
      "id": "kpk1-l04-b2-t02",
      "before": "kpk1-l04-b2-e05",
      "title": {
        "en": "Kończyć: to finish"
      },
      "body": {
        "en": "*Kończyć* has *cz* before its ending, so it goes like *uczyć się*: *kończę*, *kończysz*, *kończy*, *kończymy*, *kończycie*, *kończą*. *Kończę kurs* is \"I am finishing the course\"."
      },
      "conjugation": {
        "verb": "kończyć",
        "meaning": {
          "en": "to finish"
        },
        "forms": {
          "ja": "kończę",
          "ty": "kończysz",
          "on": "kończy",
          "my": "kończymy",
          "wy": "kończycie",
          "oni": "kończą"
        }
      }
    }
  ],
