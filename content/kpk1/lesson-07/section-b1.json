  "tips": [
    {
      "id": "kpk1-l07-b1-t01",
      "before": "kpk1-l07-b1-e01",
      "title": {
        "en": "Proszę…"
      },
      "body": {
        "en": "In a shop, ask for a thing with *proszę* and the accusative: *proszę gazetę*, *proszę kanapkę*, *proszę wodę*. A masculine thing stays as it is: *proszę sok*. In *woda mineralna*, mineral water, the adjective that says the kind comes after the noun."
      }
    },
    {
      "id": "kpk1-l07-b1-t02",
      "before": "kpk1-l07-b1-e12",
      "title": {
        "en": "Czy jest…?"
      },
      "body": {
        "en": "To ask if a shop has something, say *czy jest…?* for one thing and *czy są…?* for several: *czy jest sok?*, *czy są chipsy?*. The answer is *tak, jest*, *tak, są*, or for both *nie, nie ma*."
      },
      "kind": "uwaga"
    }
  ],
