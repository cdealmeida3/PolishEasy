      "title": {
        "en": "Kupować"
      },
      "body": {
        "en": "*Kupować* goes like every *-ować* verb: *kupuję, kupujesz, kupuje … kupują*. What you buy takes the accusative: *kupuję gazetę*, *kupuję kawę*. A masculine thing stays as it is: *piszę list*, *kupuję bilet*."
      },
      "conjugation": {
        "verb": "kupować",
        "meaning": {
          "en": "to buy"
        },
        "forms": {
          "ja": "kupuję",
          "ty": "kupujesz",
          "on": "kupuje",
          "my": "kupujemy",
          "wy": "kupujecie",
          "oni": "kupują"
        }
      }
    }
  ],
