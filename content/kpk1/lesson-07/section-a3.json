    {
      "id": "kpk1-l07-a3-t02",
      "before": "kpk1-l07-a3-e09",
      "title": {
        "en": "Mój, twój"
      },
      "body": {
        "en": "*Mój* and *twój* change like adjectives: *mojego*, *twojego* for a man or an animal, *moją*, *twoją* for a woman. *Znam twojego brata*, *lubię twoją siostrę*."
      },
      "kind": "uwaga"
    }
