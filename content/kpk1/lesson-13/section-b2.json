    {
      "id": "kpk1-l13-b2-t01",
      "before": "kpk1-l13-b2-e01",
      "title": {
        "en": "Miałem, mieliśmy"
      },
      "body": {
        "en": "*Mieć* has *a* in the past: *miałem*, *miałam*, *miał*, *miała*. Only the plural with a man in the group keeps the *e*: *mieliśmy*, *mieliście*, *mieli*. Women only: *miałyśmy*, *miałyście*, *miały*."
      },
      "table": {
        "title": {
          "en": "mieć · to have · the past, one person"
        },
