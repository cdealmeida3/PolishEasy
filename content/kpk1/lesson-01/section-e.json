  "tips": [
    {
      "id": "kpk1-l01-e-t01",
      "before": "kpk1-l01-e-e01",
      "title": {
        "en": "When you don't understand"
      },
      "body": {
        "en": "*Nie* before a verb makes it no: *rozumiem* (I understand), *nie rozumiem* (I don't understand); *wiem*, *nie wiem*. Ask *co to znaczy?* for a word you don't know, and *jak się mówi po polsku…?* for a word you need. *Proszę powtórzyć* asks the teacher to say it again."
      }
    },
    {
      "id": "kpk1-l01-e-t02",
      "before": "kpk1-l01-e-e11",
      "title": {
        "en": "The book's instructions"
      },
      "body": {
        "en": "The book's tasks ask you to *dopasować* (match), *podkreślić* (underline) or *ponumerować* (number). Like every instruction they come after *proszę*: *proszę dopasować*."
      },
      "kind": "zapamietaj"
    }
  ],
